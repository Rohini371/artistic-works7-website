.collection-card-image img,
.explore-card-image img,
.exp-image img,
.community-moment-card img,
.spotlight-card img,
.banner-image,
.gallery-thumb img,
.workshop-card img,
.service-card img,
/* .gallery-card img, */
.category-card img {
