/* ================================
   ARTISTIC WORKS 7 - PREMIUM STYLING
   ================================ */

/* Color Palette - Premium Artistic */
:root {
    /* AW7 Unified Studio Palette */

    --cream-bg: #F7F4F0;
    --light-cream: #FCFAF7;
    --warm-beige: #F2ECE5;
    --warm-ivory: #EFE8E0;

    /* Primary palette */
    --muted-terracotta: #D9745B;
    --heading-warm: #2A2028;
    --nav-text: #342832;
    --nav-hover: #E3A857;
    --accent-label: #D9745B;

    --text-dark: #4E4348;
    --deep-taupe: #1E121C;
    --soft-brown: #6B6166;

    --accent-warm: #D9745B;
    --sage-green: #C6B89F;
    --dusty-blush: #E7CBBF;

    --soft-gray: #8E8682;
    --white: #FFFFFF;

    --floral-accent: rgba(217,116,91,0.08);

    /* Shadows */
    --shadow-light: 0 8px 32px rgba(30,18,28,0.06);
    --shadow-medium: 0 12px 48px rgba(30,18,28,0.10);
    --shadow-deep: 0 20px 60px rgba(30,18,28,0.14);

    /* New reusable design tokens */
    --card-bg: #FBF8F4;
    --card-hover: #FCF8F4;
    --navbar-bg: rgba(247,244,240,0.88);
    --navbar-scrolled: rgba(242,236,229,0.95);

    --button-primary: #D9745B;
    --button-primary-hover: #C7644C;

    --button-secondary-border: #C9B7AA;
    --button-secondary-hover: #E3A857;

    --chip-bg: rgba(217,116,91,0.08);
    --chip-text: #5B4A4F;

    --footer-bg: #1E121C;
    --footer-text: #EDE5DE;
}



.is-hidden {
    display: none !important;
}

/* Typography color hierarchy */
body, p, li, .lead, .card-description, .featured-card-description, .why-card-description {
    color: var(--text-dark);
}

h1, h2, h3, h4, h5, h6, .section-title, .featured-card-title, .explore-card-title, .why-card-title {
    color: var(--heading-warm);
}

nav {
    color: var(--nav-text);
}

nav .nav-links a, .logo-monogram {
    color: var(--nav-text);
}

nav .nav-links a:hover, nav .nav-links a:focus {
    color: var(--nav-hover);
}

.accent-label, .subhead, .section-subtitle {
    color: var(--accent-label);
}

a {
    color: var(--nav-hover);
    transition: color 0.18s ease;
}

/* -----------------------
   Phase 2: Healing Section
   ----------------------- */
.healing-section {
    padding: 4.2rem 0;
    background: linear-gradient(180deg, rgba(255,248,239,0.6), rgba(253,251,248,1));
    position: relative;
}
.healing-section .section-container {
    max-width: 1280px;
    margin: 0 auto;
}
.split-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.8rem;
    justify-items: center;
    text-align: center;
}
.healing-left {
    max-width: 760px;
    width: 100%;
}
.healing-left .left-align { text-align: center; }
.healing-left .section-title { margin-bottom: 0.4rem; }
.healing-left .section-subtitle { margin-bottom: 1.6rem; color: var(--soft-brown); }
.healing-points {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    display: grid;
    gap: 1rem;
    max-width: 660px;
}
.healing-points li {
    background: linear-gradient(180deg, var(--white), var(--warm-ivory));
    padding: 1rem 1.2rem;
    border-radius: 10px;
    box-shadow: var(--shadow-light);
    display: flex;
    flex-direction: column;
    text-align: left;
}
.healing-points li strong {
    color: var(--heading-warm);
    font-weight: 600;
    margin-bottom: 4px;
}
.healing-points li span {
    color: var(--text-dark);
    font-size: 0.95rem;
}
.healing-right {
    position: relative;
    display: flex;
    justify-content: center;
    width: 100%;
}
.healing-image-placeholder {
    width: 100%;
    max-width: 620px;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow-medium);
}
.floating-accent.soft-blob {
    position: absolute;
    right: 50%;
    top: 10%;
    transform: translateX(80px) translateY(-8px);
    width: 160px;
    height: 160px;
    background: radial-gradient(circle at 30% 30%, rgba(200,155,136,0.12), rgba(233,210,200,0.04));
    border-radius: 50%;
    filter: blur(8px);
}

/* -----------------------
   Events / Experiences
   ----------------------- */
.events-section { padding: 3.6rem 0; background: transparent; }

/* Category Filter Buttons */
.category-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin: 2.4rem 0 2.8rem;
}
.category-btn {
    padding: 0.75rem 1.4rem;
    border: 2px solid var(--muted-terracotta);
    background: transparent;
    color: var(--muted-terracotta);
    border-radius: 999px;
    font-weight: 500;
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s ease;
}
.category-btn:hover {
    background: rgba(200, 155, 136, 0.1);
    transform: translateY(-2px);
}
.category-btn.active {
    background: var(--muted-terracotta);
    color: var(--white);
    box-shadow: 0 8px 20px rgba(200, 155, 136, 0.25);
}

/* Premium workshop booking filters */
.workshops-section .workshop-filter-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 1.25rem;
    margin: 2.6rem auto 3rem;
    max-width: 1120px;
}

.workshops-section .workshop-filter-card {
    display: block;
    padding: 1.5rem;
    border-radius: 24px;
    background: #FBF8F4;
    border: 1px solid rgba(92, 72, 68, 0.08);
    box-shadow: 0 18px 48px rgba(94,77,71,0.08),
                inset 0 1px 0 rgba(255,255,255,0.72);
}

.workshops-section .workshop-month-card {
    grid-column: 1 / -1;
}

.workshops-section .filter-heading {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1rem;
}

.workshops-section .filter-icon {
    width: 2.25rem;
    height: 2.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: rgba(201,122,115,0.12);
    color: #A56E68;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.8);
    font-size: 1.05rem;
}

.workshops-section .filter-label {
    color: var(--deep-taupe);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.16rem;
    font-weight: 700;
    letter-spacing: 0;
}

.workshops-section .filter-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
}

.workshops-section .month-chip-row {
    justify-content: center;
}

.workshops-section .category-btn {
    border: 1px solid rgba(92, 72, 68, 0.08);
    background: #F6F1EB;
    color: var(--deep-taupe);
    box-shadow: 0 8px 18px rgba(94,77,71,0.04);
    padding: 0.78rem 1.15rem;
    line-height: 1;
}

.workshops-section .category-btn:hover {
    background: #CFB8C7;
    border-color: #BFA5B7;
    color: #4A3335;
    transform: translateY(-2px);
}

.workshops-section .category-btn.active {
    background: #C97A73;
    color: #fff;
    border-color: #C97A73;
    box-shadow: 0 12px 28px rgba(196,109,91,0.25);
}

@media screen and (max-width: 900px) {
    .workshops-section .workshop-filter-panel {
        grid-template-columns: 1fr;
        gap: 1rem;
    }

    .workshops-section .workshop-month-card {
        grid-column: auto;
    }
}

@media screen and (max-width: 560px) {
    .workshops-section .workshop-filter-panel {
        margin: 2rem auto 2.4rem;
    }

    .workshops-section .workshop-filter-card {
        padding: 1rem;
        border-radius: 20px;
    }

    .workshops-section .filter-chip-row,
    .workshops-section .month-chip-row {
        gap: 0.65rem;
        justify-content: flex-start;
    }

    .workshops-section .category-btn {
        padding: 0.72rem 0.95rem;
        font-size: 0.88rem;
    }
}

.workshop-empty-state {
    max-width: 1040px;
    margin: 0 auto 2.25rem;
    padding: 1.35rem;
    border-radius: 24px;
    background: linear-gradient(180deg,rgba(255,247,238), rgba(248,241,233,0.94));
    border: 1px solid rgba(200,155,136,0.22);
    box-shadow: 0 24px 50px rgba(94,77,71,0.08);
}

.empty-state-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    text-align: center;
}

.empty-state-label {
    margin: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--heading-warm);
}

.empty-state-copy,
.empty-state-subtext {
    margin: 0;
    max-width: 720px;
    line-height: 1.75;
    color: var(--text-dark);
}

.empty-state-subtext {
    color: var(--soft-brown);
}

.empty-state-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.4rem;
}

.empty-state-actions .btn {
    min-width: 165px;
}

.workshop-actions-row {
    display: flex;
    justify-content: flex-start;
    margin: 1.4rem 0 0;
}

.workshop-actions-row .btn {
    min-width: 220px;
}

.premium-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(31, 19, 11, 0.45);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);

    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.premium-modal-overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
     display: none !important;
}

body.modal-open {
    overflow: hidden;
}

.premium-modal {
    width: min(720px, 96%);
    max-width: 720px;
    max-height: 90vh;
    border-radius: 28px;
    background: linear-gradient(180deg,rgba(255,247,238), rgba(245,236,224,0.98));
    box-shadow: 0 32px 70px rgba(94,77,71,0.22);
    position: relative;
    transform: translateY(20px) scale(0.98);
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.premium-modal-body {
    overflow-y: auto;
    flex: 1 1 auto;
    min-height: 0;
    padding: 1.8rem 2rem 1.2rem;
    scroll-behavior: smooth;
}

.premium-modal-body::-webkit-scrollbar {
    width: 10px;
}

.premium-modal-body::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.4);
    border-radius: 999px;
}

.premium-modal-body::-webkit-scrollbar-thumb {
    background: rgba(200,155,136,0.45);
    border-radius: 999px;
}

.premium-modal-overlay:not(.is-hidden) .premium-modal {
    transform: translateY(0) scale(1);
    opacity: 1;
}

.premium-modal-copy h2 {
    margin: 0 0 0.4rem;
    font-size: 2rem;
    line-height: 1.05;
    color: var(--heading-warm);
}

.premium-modal-copy p {
    margin: 0;
    color: var(--text-dark);
    opacity: 0.9;
    line-height: 1.75;
}

.modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 50%;
    background: rgba(255,255,255,0.88);
    color: var(--deep-taupe);
    font-size: 1.35rem;
    cursor: pointer;
    box-shadow: 0 12px 24px rgba(94,77,71,0.1);
}

.premium-modal-form {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
}

.modal-field-row {
    display: grid;
    gap: 0.45rem;
}

.modal-row-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
}

.modal-field-column {
    display: grid;
    gap: 0.45rem;
}

.modal-field-row label {
    color: var(--deep-taupe);
    font-weight: 600;
    font-size: 0.95rem;
}

.modal-field-row input,
.modal-field-row select,
.modal-field-row textarea {
    width: 100%;
    border: 1px solid rgba(94,77,71,0.18);
    border-radius: 18px;
    padding: 1rem 1rem;
    background: rgba(255,255,255,0.9);
    color: var(--text-dark);
    font-family: inherit;
    font-size: 0.97rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.modal-field-row input:focus,
.modal-field-row select:focus,
.modal-field-row textarea:focus {
    outline: none;
    border-color: rgba(200,155,136,0.85);
    box-shadow: 0 0 0 4px rgba(200,155,136,0.14);
}

.modal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: flex-end;
    margin-top: 0.4rem;
    padding-bottom: 1rem;
}

.modal-actions .btn {
    min-width: 160px;
}

@media screen and (max-width: 720px) {
    .premium-modal-body {
        padding: 1.25rem 1.25rem 1rem;
    }

    .premium-modal-copy h2 {
        font-size: 1.75rem;
    }

    .modal-actions {
        justify-content: center;
    }
}

@media screen and (max-width: 560px) {
    .premium-modal {
        width: min(96%, 100%);
        max-width: 96%;
        padding: 0;
        border-radius: 24px;
    }

    .premium-modal-body {
        padding: 1rem 1rem 0.75rem;
    }

    .premium-modal-copy h2 {
        font-size: 1.45rem;
    }

    .premium-modal-copy p {
        font-size: 0.96rem;
    }

    .modal-close-btn {
        top: 0.8rem;
        right: 0.8rem;
    }

    .modal-row-grid {
        grid-template-columns: 1fr;
    }

    .modal-actions {
        justify-content: stretch;
    }

    .modal-actions .btn {
        width: 100%;
        min-width: 0;
    }

    .modal-field-row input,
    .modal-field-row select,
    .modal-field-row textarea {
        padding: 1rem 0.95rem;
    }
}

@media screen and (max-width: 520px) {
    .workshop-empty-state {
        padding: 1rem;
    }

    .empty-state-label {
        font-size: 1.35rem;
    }

    .modal-close-btn {
        top: 0.8rem;
        right: 0.8rem;
    }
}

/* Experience Cards */
.events-grid{
    display:grid;
    grid-template-columns: repeat(4, minmax(0,1fr));
    gap: 2rem;
    width:100%;
}
@media (max-width:1200px){
    .events-grid{
        grid-template-columns: repeat(2,1fr);
    }
}

@media (max-width:768px){
    .events-grid{
        grid-template-columns: 1fr;
    }
}

.experience-card{
    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,0.92),
            rgba(250,245,239,0.96)
        );

    border:1px solid rgba(120,90,70,0.08);

    box-shadow:
        0 12px 35px rgba(88,72,66,0.06),
        0 2px 10px rgba(88,72,66,0.04);

    border-radius:28px;
}

.experience-card:hover{
    transform:translateY(-10px);
    box-shadow:
        0 28px 60px rgba(88,72,66,0.12);
}
.register-workshop-wrap{
    display:flex;
    justify-content:center;
    margin-top:3rem;
}

.exp-image{
    height: 200px;
    overflow:hidden;
    flex-shrink:0;
}

.exp-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:transform .5s ease;
}

.experience-card:hover .exp-image img{
    transform:scale(1.05);
}

.exp-body{
    padding: 1.35rem;
    display:flex;
    flex-direction:column;
    flex:1;
}

.exp-body h3{
    margin-bottom:.7rem;
    line-height:1.3;
}

.experience-meta{
    margin-top:auto;
    padding-top:1rem;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

