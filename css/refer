/* ==========================
   GALLERY PAGE - PREMIUM EDITORIAL
   SAFE REPLACEMENT
   ========================== */

.gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    align-items: stretch;
    margin-top: 2rem;
}
.gallery-card {
    background: #f4efe9;
    border: none !important;
    box-shadow: none !important;

    border-radius: 30px;
    overflow: hidden;

    min-height: 440px;
    height: 100%;

    display: flex;
    flex-direction: column;

    padding: 0;
    transition: transform 0.35s ease;
}

.gallery-card-content {
    padding: 1.2rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.gallery-card p {
    flex-grow: 1;
}
.gallery-card:hover {
    
    transform: translateY(-8px);
    border-color: rgba(184, 144, 107, 0.28);

    box-shadow:
        0 30px 70px rgba(61, 39, 28, 0.12);
}

/* image wrapper */
/* image wrapper */
.gallery-card-image {
    padding: 1rem 1rem 0;
    display: flex;
    justify-content: center;
}

/* image */
.gallery-card-image img,
.gallery-card img {
    width: 100%;
    height: 230px;

    object-fit: contain;
    object-position: center top;

    border-radius: 0;
    display: block;

    transition: transform 0.5s ease;
}

/* hover */
.gallery-card:hover img {
    transform: scale(1.03);
}

/* content */
.gallery-card-content {
    padding: 1.1rem 1.4rem 1.4rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

/* small category text */
.gallery-tag {
    font-size: 0.88rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #887868;
    margin-bottom: 0.55rem;
    font-weight: 500;
}

/* title */
.gallery-card h3 {
    font-size: clamp(1.9rem, 2vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: 0.8rem;
    line-height: 1.15;
    font-weight: 500;
    color: #2f2027;
    font-family: "Cormorant Garamond", serif;
}

/* description */
.gallery-card p {
    color: #665d57;
    line-height: 1.8;
    font-size: 1.02rem;
    margin: 0;
}

/* subtle luxury shine */
.gallery-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,0.18),
            transparent 35%
        );
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
}

.gallery-card:hover::before {
    opacity: 1;
}

/* mobile */
@media (max-width: 768px) {
    .gallery-grid {
        grid-template-columns: 1fr;
        gap: 1.4rem;
    }

    .gallery-card {
        min-height: auto;
        border-radius: 26px;
    }

    .gallery-card img {
        height: 280px;
        border-radius: 22px;
    }

    .gallery-card h3 {
        font-size: 1.6rem;
    }
}
.category-grid .collection-card {
    min-height: 180px;
}

