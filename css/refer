/* -----------------------
   Page-specific premium cards
   ----------------------- */
.page-intro {
    max-width: 760px;
    margin: 0 auto 2rem;
    text-align: center;
    color: var(--soft-brown);
    line-height: 1.85;
}
.service-grid,
.collection-grid,
/* .gallery-grid, */
.workshop-grid,
.category-grid,
.location-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.6rem;
    margin-top: 2rem;
}
.location-card {
    background: var(--card-bg);
    border: 1px solid rgba(212,168,153,0.18);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(94,77,71,0.08);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    display: flex;
    flex-direction: column;
    cursor: pointer;
}
.location-section .location-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: stretch;
}

/* Ensure every location-card gets identical internal sizing */
.location-grid > .location-card {
    min-height: 360px;
}

.location-grid > .location-card .card-image-container {
    height: 180px;
}

.location-grid > .location-card .location-card-content {
    min-height: calc(360px - 180px);
}

/* Keep chip row in a consistent place across all cards */
.location-card-content {
    justify-content: flex-start;
}

.location-card-content .location-card-content h3,
.location-card-content .location-types,
.location-card-content .location-sessions,
.location-card-content .btn-small {
    display: block;
}


.location-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 26px 62px rgba(94,77,71,0.12);
}
.location-card .card-image-container {
    width: 100%;
    height: 180px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(249,241,232,1), rgba(238,226,216,1));
}
.location-card .card-image-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
}
.location-card:hover .card-image-container img {
    transform: scale(1.03);
}
.location-card-content {
    padding: 1.5rem 1.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    flex-grow: 1;
}
.location-card-content h3 {
    margin: 0;
    font-size: 1.25rem;
    color: var(--deep-taupe);
}
.location-types {
    color: var(--soft-brown);
    font-size: 0.95rem;
    line-height: 1.7;
}
.location-sessions {
    font-weight: 600;
    color: var(--heading-warm);
}
.location-card-content .btn-small {
    align-self: flex-start;
    padding: 0.85rem 1.3rem;
    font-size: 0.9rem;
}
.location-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.1rem;
    justify-content: center;
    align-items: center;
}
.location-chip {
    font-size: 0.82rem;
    color: var(--deep-taupe);
    background: var(--chip-bg);
    color: var(--chip-text);    padding: 0.7rem 1rem;
    border-radius: 999px;
    letter-spacing: 0.4px;
}

.location-section-cta {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
}
.service-card,
.collection-card,
.gallery-card {
    background: #FFFFFF;
    border: 1px solid rgba(90, 100, 120, 0.08);
    border-radius: 22px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
    transition: transform 0.35s ease, box-shadow 0.35s ease;
    display: flex;
    flex-direction: column;
    min-height: 260px;
    display: flex;
    justify-content: space-between;
    padding: 22px;
    height: 100%;
}

.collection-card,
.category-card,
.service-card,
.workshop-card {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.collection-card-content,
.card-content,
.category-content {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.workshop-card h2,
.workshop-card h3,
.experience-card h2,
.experience-card h3 {
    line-height: 1.25;
    white-space: normal;
}

.service-card:hover,
