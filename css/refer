    padding: 90px 40px 60px;
    border-radius: 0 0 28px 28px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(
        180deg,
        #F7F4F0 0%,
        #F7F4F0 100%
    );

    position: relative;
    overflow: hidden;
}

.hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: none; /* removed overlay */
    pointer-events: none;
    z-index: 2;
}

/* Hero Image Banner */
.hero-image-banner {
    position: relative;
    width: 100%;
    height: 525px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    margin-top: 0;
    border-radius: 0;
    box-shadow: 0 12px 32px rgba(94, 77, 71, 0.08);
}

.hero-image-banner::after {
    background:
        linear-gradient(
            180deg,
            rgba(48,28,22,0.08),
            rgba(48,28,22,0.14)
        );
}

.banner-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
}

/* ensure hero content overlays the banner image */
.hero-image-banner .hero-content { position: relative; z-index: 3; padding: 3.2rem 1rem 2rem; }
.hero-image-banner .hero-text-container { max-width: 980px; margin: 0 auto; text-align: center; }
.hero-image-banner .hero-title { color: #fff; font-size: 3.4rem; margin: 0; }

/* Banner pages where navbar overlays the hero (no cream gap) */
.navbar--hero-transparent {
    position: fixed !important;
    top: 0;
    left: 0;
    width: 100%;
    background: transparent !important;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    box-shadow: none !important;
    border-bottom: 1px solid transparent !important;
}

.navbar--hero-transparent.scrolled {
    background: rgba(255, 248, 240, 0.72) !important;
    backdrop-filter: blur(24px) saturate(1.08);
    -webkit-backdrop-filter: blur(24px) saturate(1.08);
    box-shadow: 0 16px 44px rgba(94, 77, 71, 0.1) !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.34) !important;
}

.navbar--hero-transparent .nav-link {
    color: rgba(255, 255, 255, 0.92) !important;
}

.navbar--hero-transparent .logo-text {
    color: #ffffff;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.16);
}

.navbar--hero-transparent.scrolled .logo-text,
.navbar--hero-transparent.scrolled .nav-link {
    color: var(--nav-text) !important;
    text-shadow: none;
}

.navbar--hero-transparent .nav-link:hover {
    color: #ffffff !important;
    background: rgba(255, 255, 255, 0.08);
}

.navbar--hero-transparent.scrolled .nav-link:hover {
    color: #6b554f !important;
    background: rgba(212, 168, 153, 0.08);
}

.navbar--hero-transparent .nav-link.active {
    background: rgba(255, 255, 255, 0.18);
    color: #ffffff !important;
    border-radius: 12px;
}

.navbar--hero-transparent.scrolled .nav-link.active {
    background: rgba(212, 168, 153, 0.14);
    color: var(--nav-text) !important;
}

.navbar--hero-transparent .nav-link::after {
    background: rgba(255, 255, 255, 0.7);
}

.navbar--hero-transparent + .hero-image-banner {
    margin-top: 0;
}

/* Extra safety: when navbar is overlay-transparent, avoid any additional top gap */
.navbar--hero-transparent + .hero-image-banner,
.navbar--hero-transparent + .workshop-banner,
.navbar--hero-transparent + .shop-banner,
.navbar--hero-transparent + .gift-banner {
    margin-top: 0;
}


/* Extra safety: prevent the hero overlay pages from reserving space */
.navbar--hero-transparent .hero-image-banner {
    margin-top: 0;
}



