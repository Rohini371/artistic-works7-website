section {
    position: relative;
}

section + section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212,168,153,0.18), transparent);
    opacity: 0.4;
    pointer-events: none;
}

