/* ================================
   SECTION COMMON STYLES
   ================================ */

.section-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
}

.section-header {
    text-align: center;
    margin-bottom: 3.2rem; /* reduced vertical spacing ~20% */
    animation: fadeInUp 0.8s ease-out;
}

.section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    color: var(--deep-taupe);
    margin-bottom: 0.8rem;
    letter-spacing: -0.5px;
}

.section-subtitle {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--soft-brown);
    font-weight: 400;
    letter-spacing: 0.3px;
}

/* ================================
   EXPLORE BY EXPERIENCE SECTION
   ================================ */

.explore-section {
    background: linear-gradient(180deg, var(--cream-bg) 0%, #fdfbf8 100%);
    padding: 3rem 0 3.2rem;
    position: relative;
    overflow: hidden;
}

.explore-section .section-header {
    margin-bottom: 2rem;
}

.explore-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(212, 168, 153, 0.2), transparent);
}

.explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.6rem;
    animation: fadeInUp 1s ease-out 0.2s both;
}

.explore-card {
    position: relative;
    display: block;
    cursor: pointer;
    border-radius: 18px;
    overflow: hidden;
    background: var(--card-bg);
    box-shadow: 0 18px 48px rgba(94,77,71,0.08), inset 0 1px 0 rgba(255,255,255,0.65);
    transition: transform 0.4s ease, box-shadow 0.4s ease;
    opacity: 0;
    transform: translateY(24px);
    text-decoration: none;
    color: inherit;
}

.explore-card.in-view {
    opacity: 1;
    transform: translateY(0);
}

.explore-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 28px 72px rgba(94,77,71,0.12), inset 0 1px 0 rgba(255,255,255,0.7);
}

.explore-card-image {
    width: 100%;
    height: 158px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(249,241,232,1), rgba(238,226,216,1));
    position: relative;
    border-bottom: 1px solid rgba(94,77,71,0.05);
}

.explore-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.65s ease;
}

.explore-card:hover .explore-card-image img {
    transform: scale(1.03);
}

.image-placeholder {
    width: 100%;
    height: 100%;
    transition: transform 0.65s ease, filter 0.65s ease;
    background: linear-gradient(135deg, rgba(249,241,232,0.97), rgba(237,226,216,0.97));
    position: relative;
}

.image-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 24% 24%, rgba(255,255,255,0.45), transparent 18%), radial-gradient(circle at 70% 70%, rgba(255,255,255,0.24), transparent 16%);
    opacity: 0.85;
    pointer-events: none;
}

.image-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255,255,255,0.25), rgba(255,255,255,0) 38%, rgba(255,255,255,0.16));
    pointer-events: none;
}

.explore-card:hover .image-placeholder {
    transform: scale(1.05);
}

.explore-card-content {
    padding: 1.8rem 1.5rem;
    background: transparent;
    position: relative;
    z-index: 2;
}

.explore-card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--deep-taupe);
    margin-bottom: 0.5rem;
    letter-spacing: -0.3px;
}

.explore-card-description {
    font-size: 0.9rem;
    color: var(--soft-brown);
    line-height: 1.6;
}

.explore-card-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--muted-terracotta), var(--accent-warm));
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.explore-card:hover .explore-card-overlay {
    opacity: 1;
}

