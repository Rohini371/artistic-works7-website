/* ==========================================
   WORKSHOP VIDEO REELS (PREMIUM CIRCULAR)
========================================== */

.workshop-reels-section{
    position: relative;
    padding: 10px 0 8px;
    overflow: hidden;
    min-height: 360px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #F7F3EE;
    overflow: hidden;
}

.workshop-reels-section::before{
    content:'';
    position:absolute;
    top:50%;
    left:50%;

    width:700px;
    height:320px;

    transform:translate(-50%,-50%);

    background:
        radial-gradient(
            circle,
            rgba(255,255,255,.06),
            transparent 70%
        );

    pointer-events:none;
}

.workshop-reels-section .reels-track{
    position: relative;
    width: 100%;
    height: 470px;
    overflow: hidden;
    cursor: grab;
    user-select: none;
}

.workshop-reels-section .reels-track::-webkit-scrollbar{
    width: 0;
    height: 0;
}

.workshop-reels-section .reels-track:active{
    cursor: grabbing;
}

/* Cards are absolutely positioned and transformed.
   Visible cards only: center, left-1, left-2, right-1, right-2
*/
.workshop-reels-section .reel-card{
    position: absolute;
    top: 50%;
    left: 50%;

    width: 270px;
    height: 410px;

    border-radius: 34px;
    overflow: hidden;
    background: #000;

    box-shadow:
        0 22px 60px rgba(0,0,0,.18),
        0 1px 0 rgba(255,255,255,.06);

    transition:
        transform 650ms cubic-bezier(.2,.9,.2,1),
        opacity 450ms ease,
        filter 450ms ease;

    transform-origin: center center;
    opacity: 0;
    pointer-events: none;
}

.workshop-reels-section .reel-card video{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

/* CENTER */
.workshop-reels-section .reel-card.center{
    opacity: 1;
    pointer-events: auto;
    z-index: 6;
    filter: saturate(1.05) contrast(1.02);

    transform:
        translate(-50%, -52%)
        scale(0.96);
}

/* FIRST LEFT */
.workshop-reels-section .reel-card.left-1{
    opacity: .95;
    pointer-events: auto;
    z-index: 5;
    filter: saturate(.95);

    transform:
        translate(-50%, -50%)
        translateX(-200px)
        scale(.78);
}

/* FIRST RIGHT */
.workshop-reels-section .reel-card.right-1{
    opacity: .95;
    pointer-events: auto;
    z-index: 5;
    filter: saturate(.95);

    transform:
        translate(-50%, -50%)
        translateX(200px)
        scale(.78);
}

/* SECOND LEFT */
.workshop-reels-section .reel-card.left-2{
    opacity: .22;
    pointer-events: auto;
    z-index: 4;

    filter:
        blur(1px)
        brightness(.62);

    transform:
        translate(-50%, -50%)
        translateX(-360px)
        scale(.68);
}

.workshop-reels-section .reel-card.right-2{
    opacity: .22;
    pointer-events: auto;
    z-index: 4;

    filter:
        blur(1px)
        brightness(.62);

    transform:
        translate(-50%, -50%)
        translateX(360px)
        scale(.68);
}

/* HIDDEN */
.workshop-reels-section .reel-card.hidden{
    opacity: 0;
    pointer-events: none;
    z-index: 1;

    transform:
        translate(-50%, -50%)
        scale(.5);
}

.workshop-reels-section .reel-card::after{
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;

    background:
        linear-gradient(
            180deg,
            rgba(255,255,255,.03) 0%,
            rgba(0,0,0,.08) 40%,
            rgba(0,0,0,.22) 100%
        );
}

